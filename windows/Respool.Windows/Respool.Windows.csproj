<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app: a tray icon, a global shortcut and a panel at the right edge of the
       screen. EnableWindowsTargeting lets it be compiled on macOS and Linux too, which is how it
       is checked there; it only runs on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF and Windows Forms share type names; every file says which it means. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Respool</AssemblyName>
    <RootNamespace>Respool.Windows</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respool.Core\Respool.Core.csproj" />
  </ItemGroup>

</Project>
