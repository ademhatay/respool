<Window x:Class="Respool.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Respool"
        Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- The panel: a rounded sheet at the right edge with a search field, the chats and a status line. -->
    <Border x:Name="Sheet" Margin="10" CornerRadius="12" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="SearchBox" Grid.Row="0" Margin="12,12,12,8" Height="40" CornerRadius="9">
                <Grid Margin="12,0">
                    <TextBlock x:Name="Placeholder" VerticalAlignment="Center" FontSize="14" IsHitTestVisible="False" />
                    <TextBox x:Name="Query" VerticalAlignment="Center" FontSize="14" BorderThickness="0"
                             Background="Transparent" TextChanged="OnQueryChanged" />
                </Grid>
            </Border>

            <ListBox x:Name="List" Grid.Row="1" Margin="6,0" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnListDoubleClick" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding TitleBrush}" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" Foreground="{Binding DetailBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,2,0,0">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{Binding LiveBrush}"
                                         Visibility="{Binding LiveVisibility}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{Binding DetailBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu x:Name="RowMenu" Opened="OnRowMenuOpened" />
                </ListBox.ContextMenu>
            </ListBox>

            <Border x:Name="Footer" Grid.Row="2" BorderThickness="0,1,0,0" Padding="18,8">
                <Grid>
                    <TextBlock x:Name="Status" FontSize="11" />
                    <TextBlock x:Name="ShortcutLabel" FontSize="11" HorizontalAlignment="Right" Text="Alt+Shift+Space" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
